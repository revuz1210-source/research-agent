# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit real secrets.
#
#   cp .env.example .env

# ── Required for real LLM responses ──────────────────────────────────────────
# Leave blank to run in offline/mock mode (no API calls).
OPENAI_API_KEY=

# ── Optional: higher Semantic Scholar rate limits ─────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=

# ── Optional: override LLM model ─────────────────────────────────────────────
OPENAI_MODEL=gpt-4o

# ── Optional: report output directory ────────────────────────────────────────
REPORT_OUTPUT_DIR=reports
